# Скопируйте этот файл в .env.local и заполните значения.
# Пока они пустые, заказ не уходит автоматически: в корзине работает кнопка «Написать менеджеру @Patrick_1208».

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# id чата менеджера (@Patrick_1208). Узнать: менеджер нажимает «Start» у бота, затем npm run telegram:chat-id
TELEGRAM_CHAT_ID=
